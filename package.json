{
  "name": "yoyo-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n mock,web -c gray,blue \"npm:mock\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @yoyo/web",
    "dev:worker": "npm run dev -w @yoyo/worker",
    "dev:live": "concurrently -k -n worker,web -c green,blue \"npm run dev:worker\" \"npm run dev:web\"",
    "live:check": "node tools/live-check.mjs",
    "mock": "node tools/mock-worker.mjs",
    "gen": "node tools/gen-agent-content.mjs && npm run gen -w @yoyo/worker",
    "build": "npm run build -w @yoyo/protocol && npm run build -w @yoyo/web && npm run build -w @yoyo/worker",
    "preview": "npm run preview -w @yoyo/web",
    "typecheck": "npm run typecheck -w @yoyo/protocol && npm run typecheck -w @yoyo/web && npm run typecheck -w @yoyo/worker",
    "lint": "eslint .",
    "test": "npm run gen -w @yoyo/worker && vitest run && node --test tools/mock-worker.test.mjs && npm run eval -- --quiet",
    "eval": "node tools/eval-brain.mjs",
    "deploy:worker": "npm run deploy -w @yoyo/worker",
    "shots": "node tools/shots.mjs",
    "og": "node tools/og.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.9"
  }
}
